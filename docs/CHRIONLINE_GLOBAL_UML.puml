SocketPaymentService --> StorageCryptoService

PaiementService --> Paiement
PaiementService --> EcoCommande
PaiementService --> Coupon
PaiementService --> Wallet
PaiementService --> PaiementStats
PaiementService --> AuditService
PaiementService --> FraudDetectionService
PaiementService --> PromotionService
PaiementService --> WalletService
PaiementService --> PaiementQueueService

PaymentHistoryDAO --> DB
SavedPaymentMethodDAO --> DB
SavedPaymentService --> SavedPaymentMethodDAO

ApplicationSessionRsaKeys --> SslConfigLoader
RsaOaepAesKeyWrap --> ApplicationSessionRsaKeys
AesGcmLineCipher --> SocketApiClient
AesGcmLineCipher --> ClientHandler

@enduml
