CommandeService --> CommandeDAO
CommandeService --> Commande
CommandeService --> LigneCommande
CommandeService --> ProductRepository
CommandeDAO --> DB
Commande "1" *-- "many" LigneCommande

SocketPaymentService --> CommandeService
SocketPaymentService --> PaiementService
SocketPaymentService --> PaymentHistoryDAO
